[font]
size = 14.0
normal.family = "JetbrainsMono Nerd Font"
bold.style = "Bold"
bold_italic.style = "Bold Italic"
italic.style = "Italic"

[selection]
save_to_clipboard = true

[terminal.shell]
args = ["--login", "-c", "/opt/homebrew/bin/tmux new -A"]
program = "/opt/homebrew/bin/bash"

[window.dimensions]
columns = 128
lines = 32

[general]
import = [
  "~/.config/alacritty/tokyonight_night.toml",
  "~/.alacritty.local.toml"
]

# vi:ft=toml
