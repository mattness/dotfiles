[font]
size = 14.0
normal.family = "JetbrainsMono Nerd Font"
bold.style = "Bold"
bold_italic.style = "Bold Italic"
italic.style = "Italic"

[selection]
save_to_clipboard = true

[terminal.shell]
args = ["--login", "-ic", "exec tmux new -A"]
program = "/opt/homebrew/bin/bash"

[window.dimensions]
columns = 128
lines = 32

[window]
option_as_alt = "OnlyLeft"

[colors.primary]
background = '#1a1d21'
foreground = '#c4cad1'

[colors.normal]
black = '#131518'
red = '#ef5285'
green = '#63e6be'
yellow = '#F6B352'
blue = '#6FC1FF'
magenta = '#FF9AC1'
cyan = '#45A9F9'
white = '#c4cad1'

[colors.bright]
black = '#676B79'
red = '#ef5285'
green = '#63e6be'
yellow = '#FFCC95'
blue = '#6FC1FF'
magenta = '#FF9AC1'
cyan = '#45A9F9'
white = '#c4cad1'

[[colors.indexed_colors]]
index = 16
color = '#FFCC95'

[[colors.indexed_colors]]
index = 17
color = '#db4b4b'

[general]
import = ["~/.alacritty.local.toml"]

# vi:ft=toml
