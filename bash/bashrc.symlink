# If not running interactively, don't do anything
[[ $- != *i* ]] && return

physical_dir() {
  local source=$1
  local dir=$(dirname "$source")
  while [ -h "$source" ]
  do
    source=$(readlink "$source")
    [[ $source != /* ]] && source=$dir/$source
    dir=$(cd -P "$(dirname "$source")" && pwd)
  done
  dir=$(cd -P "$(dirname "$source")" && pwd)
  echo $dir
}

dotfilesdir=$(cd -P "$(physical_dir "${BASH_SOURCE[0]}")/../" && pwd)
mapfile -t configfiles     < <(find "${dotfilesdir}" -type f -name "*.bash" -not -name 'completion.bash' -and -not -name 'path.bash')
mapfile -t pathfiles       < <(find "${dotfilesdir}" -type f -name 'path.bash')
mapfile -t completionfiles < <(find "${dotfilesdir}" -type f -name 'completion.bash')

for f in "${pathfiles[@]}"; do
  source "${f}"
done

for f in "${configfiles[@]}"; do
  source "${f}"
done

# use .localrc for machine-specific stuff
# that doesn't belong in the public repo.
if [[ -a ~/.localrc ]]; then
  source ~/.localrc
fi

for f in "${completionfiles[@]}"; do
  source "${f}"
done

# vim: ft=bash
