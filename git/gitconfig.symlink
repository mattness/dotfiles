[include]
  path = ~/.gitconfig.local

[color]
  diff = auto
  status = auto
  branch = auto

[alias]
  st = status -s
  unstage = reset HEAD --
  co = checkout
  ci = commit
  br = branch
  last = log -1 HEAD
  graph = log --graph --oneline
  conflicts = diff --name-only --diff-filter=U
  fplog = log --oneline --first-parent
  empty = commit --allow-empty -m 'Empty commit'
  amend = commit --amend --no-edit

[core]
  excludesfile = ~/.gitignore
  askpass = 

[fetch]
  prune = true
  writeCommitGraph = true

[push]
  default = matching
  followTags = true

[advice]
  detachedHead = false
  skippedCherryPicks = false
  forceDeleteBranch = false
  diverging = false

[pull]
  rebase = true

[merge]
  ff = only

[mergetool "vimdiff"]
  layout = "LOCAL,BASE,REMOTE / MERGED + BASE,LOCAL + BASE,REMOTE + (LOCAL/BASE/REMOTE),MERGED"

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[log]
  showSignature = true
