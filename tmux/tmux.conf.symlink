set-option -g default-terminal "tmux-256color"
set-option -g terminal-overrides ",*256color*:RGB,alacritty*:RGB"

# Undercurl
set -as terminal-overrides ',*:Smulx=\E[4::%p1%dm'  # undercurl support
set -as terminal-overrides ',*:Setulc=\E[58::2::::%p1%{65536}%/%d::%p1%{256}%/%{255}%&%d::%p1%{255}%&%d%;m'  # underscore colours - needs tmux-3.0

set -g default-command /opt/homebrew/bin/bash
set -g default-shell /opt/homebrew/bin/bash
set -g base-index 1
set -g mouse off
set -g history-limit 10000
set -g focus-events on

# Reset prefix to Ctrl+Space
set -g prefix C-Space
bind C-Space send-prefix
unbind C-b

# Shorten the delay between prefix and command
set -s escape-time 1

# Scratchpad
bind BSpace run-shell 'popup-tmux single'

# VIM-like pane movement keys
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

set-window-option -g mode-keys vi
set-window-option -g pane-base-index 1

# I can't remember % and "
bind | split-window -h
bind - split-window -v

# Quick Window selection
bind -r C-h select-window -t :-
bind -r C-l select-window -t :+

# Activate OFF mode to allow for sharing prefix between nested tmux sessions
bind -n F4 \
    set prefix None \;\
    set key-table off \;\
    refresh-client -S

# Disable OFF mode
bind -T off F4 \
    set -u prefix \;\
    set -u key-table \;\
    refresh-client -S

####################################################################
# Status bar                                                       #
####################################################################
%hidden blizzardblue='#00B4FF' # rgb(0,180,255)
%hidden black="#131518"
%hidden red="#ef5285"
%hidden green="#63e6be"
%hidden yellow="#f6b352"
%hidden blue="#6fc1ff"
%hidden magenta="#ff9ac1"
%hidden cyan="#45a9f9"
%hidden white="#c4cad1"
%hidden dark_grey="#31353a"
%hidden primary="${blue}"
if-shell '[[ -n "$SSH_CONNECTION" ]]' "primary=${green}"

set -g mode-style "fg=#{primary},bg=${dark_grey}"

set -g message-style "fg=${dark_grey},bg=#{primary}"
set -g message-command-style "fg=${dark_grey},bg=#{primary}"

set -g pane-border-style "fg=${dark_grey}"
set -g pane-active-border-style "fg=#{primary}"

set -g status "on"
set -g status-justify "centre"
set -g status-position "top"

set -g status-style "#{?#{==:#{client_key_table},off},fg=${red}#,bg=${dark_grey},fg=default#,bg=default}"

set -g status-left-length "100"
set -g status-right-length "100"

set -g status-left "#[fg=#{primary},bold]  #S #[fg=default,nobold]"
set -g status-right "%F | %R (#(date -u '+%%H')h) #[fg=#{primary},reverse] #h "
# set -g status-right "#{?#{==:#{client_key_table},off},#[fg=${yellow}]#[reverse] OFF ,       }#[default] %F | %R (#(date -u '+%%H')h) #[fg=#{primary},reverse] #h "

set -g window-status-separator "  "
set -g window-status-format "#I:#W#{?window_zoomed_flag, 󰊓,}"
set -g window-status-current-format "#[fg=#{primary},bold,underscore]#I:#W#{?window_zoomed_flag, 󰊓,}"
